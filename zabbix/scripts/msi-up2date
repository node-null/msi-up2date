#!/usr/bin/env bash
# Author: Mariusz Szulerecki
# Description: System update statistics for Zabbix
# Release: 2026-05-11

set -euo pipefail

AGENTD_CONF_FILE=/etc/zabbix/zabbix_agent2.conf
TEMP_ZBX_FILE=/tmp/zabbix_msi-up2date.tmp

usage() {
  echo "Usage: $0 {send|list-last|list-current|list-ready|apt-update}"
  exit 1
}

#######################################
# Detect OS family
#######################################
detect_os_family() {

  if [[ -f /etc/os-release ]]; then
    . /etc/os-release

    case "${ID,,}" in
      ubuntu)
        echo "ubuntu"
        return
        ;;

      debian)
        echo "debian"
        return
        ;;

      rhel|rocky|almalinux|centos|fedora)
        echo "redhat"
        return
        ;;
    esac
  fi

  echo "unknown"
}

#######################################
# Common OS info
#######################################
get_os_distro() {

  lsb_release -a 2>/dev/null \
    | awk -F: '/Distributor ID/ {
        gsub(/^[ \t]+/, "", $2)
        print $2
      }'
}

get_os_release() {

  lsb_release -a 2>/dev/null \
    | awk -F: '/Release/ {
        gsub(/^[ \t]+/, "", $2)
        print $2
      }'
}

#######################################
# Ubuntu package statistics
#######################################
get_updates_ubuntu() {

  local regular security updates

  if [[ -x /usr/lib/update-notifier/apt-check ]]; then

    updates=$(/usr/lib/update-notifier/apt-check 2>&1 || echo "0;0")

    regular=$(echo "$updates" | cut -d';' -f1)
    security=$(echo "$updates" | cut -d';' -f2)

  else

    regular=$(apt list --upgradable 2>/dev/null \
      | tail -n +2 \
      | wc -l)

    security=$(apt list --upgradable 2>/dev/null \
      | grep -ic security || true)

  fi

  echo "${regular};${security}"
}

#######################################
# Debian package statistics
#######################################
get_updates_debian() {

  local regular security

  regular=$(apt list --upgradable 2>/dev/null \
    | tail -n +2 \
    | wc -l)

  security=$(
    apt list --upgradable 2>/dev/null \
      | grep -Ei '(oldstable|stable)-security|security' \
      | wc -l
  )

  echo "${regular};${security}"
}

#######################################
# RedHat package statistics
#######################################
get_updates_redhat() {

  local regular=0
  local security=0

  if command -v dnf >/dev/null 2>&1; then

    regular=$(dnf check-update -q 2>/dev/null \
      | grep -E '^[a-zA-Z0-9]' \
      | wc -l)

    if dnf updateinfo list security >/dev/null 2>&1; then
      security=$(dnf updateinfo list security 2>/dev/null \
        | grep -E '^[A-Z]' \
        | wc -l)
    fi

  elif command -v yum >/dev/null 2>&1; then

    regular=$(yum check-update -q 2>/dev/null \
      | grep -E '^[a-zA-Z0-9]' \
      | wc -l)

    if yum updateinfo list security >/dev/null 2>&1; then
      security=$(yum updateinfo list security 2>/dev/null \
        | grep -E '^[A-Z]' \
        | wc -l)
    fi
  fi

  echo "${regular};${security}"
}

#######################################
# Generic package statistics dispatcher
#######################################
get_package_updates() {

  local os_family

  os_family=$(detect_os_family)

  case "$os_family" in

    ubuntu)
      get_updates_ubuntu
      ;;

    debian)
      get_updates_debian
      ;;

    redhat)
      get_updates_redhat
      ;;

    *)
      echo "0;0"
      ;;
  esac
}

#######################################
# Ubuntu dpkg history
#######################################
get_dpkg_updates_ubuntu() {

  zcat -f /var/log/dpkg.log* 2>/dev/null \
    | grep -E " install | upgrade " \
    | awk '{
        split($4,a,":")
        print $1, a[1], $6, $3, $5
      }'
}

#######################################
# Debian dpkg history
#######################################
get_dpkg_updates_debian() {

  zcat -f /var/log/dpkg.log* 2>/dev/null \
    | grep -E " install | upgrade " \
    | awk '{
        split($4,a,":")
        print $1, a[1], $6, $3, $5
      }'
}

#######################################
# RedHat package history
#######################################
get_package_updates_redhat_history() {

  if command -v dnf >/dev/null 2>&1; then

    dnf history list 2>/dev/null

  elif command -v yum >/dev/null 2>&1; then

    yum history list 2>/dev/null

  fi
}

#######################################
# Generic package history dispatcher
#######################################
get_package_history() {

  local os_family

  os_family=$(detect_os_family)

  case "$os_family" in

    ubuntu)
      get_dpkg_updates_ubuntu
      ;;

    debian)
      get_dpkg_updates_debian
      ;;

    redhat)
      get_package_updates_redhat_history
      ;;

    *)
      return 0
      ;;
  esac
}

#######################################
# Previous month updates
#######################################
last_month_updates() {

  local start end

  start=$(date -d "$(date +%Y-%m-01) -1 month" +%F)
  end=$(date -d "$(date +%Y-%m-01) -1 day" +%F)

  case "$(detect_os_family)" in

    ubuntu|debian)

      get_package_history \
        | awk -v s="$start" -v e="$end" '
            $1 >= s && $1 <= e
          '
      ;;

    redhat)

      get_package_history
      ;;

  esac
}

#######################################
# Current month updates
#######################################
current_month_updates() {

  local start end

  start=$(date +%Y-%m-01)
  end=$(date -d "$start +1 month -1 day" +%F)

  case "$(detect_os_family)" in

    ubuntu|debian)

      get_package_history \
        | awk -v s="$start" -v e="$end" '
            $1 >= s && $1 <= e
          '
      ;;

    redhat)

      get_package_history
      ;;

  esac
}

#######################################
# Ubuntu ready-to-install updates
#######################################
ready_to_install_updates_ubuntu() {

  apt list --upgradable 2>/dev/null | tail -n +2
}

#######################################
# Debian ready-to-install updates
#######################################
ready_to_install_updates_debian() {

  apt list --upgradable 2>/dev/null | tail -n +2
}

#######################################
# RedHat ready-to-install updates
#######################################
ready_to_install_updates_redhat() {

  if command -v dnf >/dev/null 2>&1; then

    dnf check-update 2>/dev/null || true

  elif command -v yum >/dev/null 2>&1; then

    yum check-update 2>/dev/null || true

  fi
}

#######################################
# Generic ready-to-install dispatcher
#######################################
ready_to_install_updates() {

  case "$(detect_os_family)" in

    ubuntu)
      ready_to_install_updates_ubuntu
      ;;

    debian)
      ready_to_install_updates_debian
      ;;

    redhat)
      ready_to_install_updates_redhat
      ;;

  esac
}

#######################################
# Ubuntu apt update
#######################################
apt_update_ubuntu() {

  apt-get update -qq >/dev/null 2>&1
}

#######################################
# Debian apt update
#######################################
apt_update_debian() {

  apt-get update -qq >/dev/null 2>&1
}

#######################################
# RedHat metadata update
#######################################
apt_update_redhat() {

  if command -v dnf >/dev/null 2>&1; then

    dnf makecache -q

  elif command -v yum >/dev/null 2>&1; then

    yum makecache -q

  fi
}

#######################################
# Generic metadata update dispatcher
#######################################
apt_update() {

  case "$(detect_os_family)" in

    ubuntu)
      apt_update_ubuntu
      ;;

    debian)
      apt_update_debian
      ;;

    redhat)
      apt_update_redhat
      ;;

  esac
}

#######################################
# Send metrics to Zabbix
#######################################
send_metrics() {

  local ZBX_SERVER
  local ZBX_HOSTNAME

  local UPDATES
  local REGULAR
  local SECURITY

  ZBX_SERVER=$(grep '^Server=' "$AGENTD_CONF_FILE" \
    | cut -d= -f2 || true)

  if [[ -z "${ZBX_SERVER:-}" ]]; then
    echo "Server is not set in zabbix_agent2.conf"
    exit 1
  fi

  if grep -q '^HostnameItem' "$AGENTD_CONF_FILE"; then
    ZBX_HOSTNAME=$(hostname)
  else
    ZBX_HOSTNAME=$(grep '^Hostname=' "$AGENTD_CONF_FILE" \
      | cut -d= -f2)
  fi

  UPDATES=$(get_package_updates)

  REGULAR=$(echo "$UPDATES" | cut -d';' -f1)
  SECURITY=$(echo "$UPDATES" | cut -d';' -f2)

  : > "$TEMP_ZBX_FILE"

  echo "\"$ZBX_HOSTNAME\" msi.up2date.os.distro $(get_os_distro)" \
    >> "$TEMP_ZBX_FILE"

  echo "\"$ZBX_HOSTNAME\" msi.up2date.os.release $(get_os_release)" \
    >> "$TEMP_ZBX_FILE"

  echo "\"$ZBX_HOSTNAME\" msi.up2date.packages.available.regular $REGULAR" \
    >> "$TEMP_ZBX_FILE"

  echo "\"$ZBX_HOSTNAME\" msi.up2date.packages.available.security $SECURITY" \
    >> "$TEMP_ZBX_FILE"

  zabbix_sender \
    --config "$AGENTD_CONF_FILE" \
    -z "$ZBX_SERVER" \
    -i "$TEMP_ZBX_FILE" \
    -vv
}

#######################################
# Dispatcher
#######################################
[[ $# -ge 1 ]] || usage

case "$1" in

  send)
    send_metrics
    ;;

  list-last)
    last_month_updates
    ;;

  list-current)
    current_month_updates
    ;;

  list-ready)
    ready_to_install_updates
    ;;

  apt-update)
    apt_update
    ;;

  *)
    usage
    ;;
esac
